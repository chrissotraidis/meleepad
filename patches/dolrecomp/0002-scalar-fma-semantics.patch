diff --git a/src/cpu/cpu.c b/src/cpu/cpu.c
index 596f379..66262a3 100644
--- a/src/cpu/cpu.c
+++ b/src/cpu/cpu.c
@@ -1193,6 +1193,38 @@ bool ppc_fma(CPUState* cpu, f64 a, f64 c, f64 b, bool single,
     return true;
 }
 
+static f32 force_single_result(const CPUState* cpu, f64 value) {
+    if (cpu->fpscr & 0x4u) {
+        u64 bits = f64_bits(value);
+        if ((bits & 0x7FFFFFFFFFFFFFFFull) < 0x3810000000000000ull)
+            return f32_value((u32)((bits & 0x8000000000000000ull) >> 32));
+    }
+    return (f32)value;
+}
+
+void ppc_fmadd_op(CPUState* cpu, u8 d, u8 a, u8 c, u8 b,
+                  bool single, bool subtract, bool negative) {
+    f64 result;
+    if (!ppc_fma(cpu, cpu->fpr[a], cpu->fpr[c], cpu->fpr[b], single,
+                 subtract, negative, &result))
+        return;
+
+    if (single) {
+        f32 rounded = force_single_result(cpu, result);
+        cpu->fpr[d] = (f64)rounded;
+        cpu->ps1[d] = (f64)rounded;
+        if (!subtract && !negative) {
+            f64 raw = fma(cpu->fpr[a], force_25_bit(cpu->fpr[c]), cpu->fpr[b]);
+            cpu->fpscr = (cpu->fpscr & ~0x00060000u) |
+                         ((raw != (f64)rounded) ? 0x00020000u : 0u);
+        }
+        set_fprf(cpu, classify_f32(rounded));
+    } else {
+        cpu->fpr[d] = result;
+        set_fprf(cpu, classify_f64(result));
+    }
+}
+
 void ppc_memory_fence(void) {
 #if defined(_MSC_VER)
     _ReadWriteBarrier();
