#!/usr/bin/env bash
set -euo pipefail

CONTENTS="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export XDG_DATA_HOME="$HOME/Library/Application Support"
export SSBMPAD_PREWARM_EFB_VRAM=1
USER_DIR="$XDG_DATA_HOME/SsbmPad"

mkdir -p "$USER_DIR/Config"
if [[ ! -f "$USER_DIR/config.ini" ]]; then
  cp "$CONTENTS/Resources/default-config.ini" "$USER_DIR/config.ini"
fi
PAD_CONFIG="$USER_DIR/Config/GCPadNew.ini"
if [[ ! -f "$PAD_CONFIG" ]]; then
  cp "$CONTENTS/Resources/default-GCPadNew.ini" "$PAD_CONFIG"
elif grep -Eq '^[[:space:]]*Device[[:space:]]*=[[:space:]]*Pipe/[0-9]+/ssbmpad[[:space:]]*$' "$PAD_CONFIG"; then
  # The pipe profile is an automation/touch-input transport. It leaves a
  # double-clicked macOS app with no keyboard controls, so restore the shipped
  # interactive profile when that internal profile is encountered.
  cp "$CONTENTS/Resources/default-GCPadNew.ini" "$PAD_CONFIG"
fi
if grep -Eq '^controller[1-4]=Pipe/[0-9]+/ssbmpad$' "$USER_DIR/config.ini"; then
  sed -E -i '' \
    's|^controller([1-4])=Pipe/[0-9]+/ssbmpad$|controller\1=Quartz/0/Keyboard \& Mouse|' \
    "$USER_DIR/config.ini"
fi

exec "$CONTENTS/MacOS/SsbmPadFrontend"
