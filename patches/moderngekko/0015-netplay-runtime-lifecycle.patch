+}
+
+void NetplaySession::FinishRuntime() {
+  if (!m_impl || !m_impl->client)
+    return;
+  m_impl->ui->SetRuntime(nullptr);
+  m_impl->client->Stop();
+  m_impl->client->StopGame();
+  m_impl->state = m_impl->ui->ConnectionLost() ? NetplayState::Failed
+                                                : NetplayState::Lobby;
 }
 
