+           << ','
+           << totals.static_recomp_fallback_mtspr -
+                  m_previous_totals.static_recomp_fallback_mtspr
+           << ','
+           << totals.static_recomp_fallback_cache -
+                  m_previous_totals.static_recomp_fallback_cache
